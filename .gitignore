# Hugo build output. Regenerated by `hugo` locally and by the build-deploy
# workflow in CI. Never commit it: a committed copy would let stale pages ride
# into the Pages artifact (Hugo does not prune files it no longer emits).
public/

# Hugo caches / lock.
resources/_gen
.hugo_build.lock

# Python bytecode from the scripts.
__pycache__/
*.pyc

# NOTE: data/ is deliberately NOT ignored.
#   data/all_posts.json  the post index extract_substack.py backfills from
#   data/raw-html/       the original Substack HTML each markdown post came
#                        from -- this is the provenance trail for the text
#   data/*-report.json   small run reports, harmless
